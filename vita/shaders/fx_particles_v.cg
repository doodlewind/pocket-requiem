void main(
    float4 aA,
    float4 aB,
    float4 aC,
    float4 iPosAge,
    float4 iDirA,
    uniform float4x4 uMvp,
    uniform float4 uP[8],
    uniform float4 uCam[3],
    out float4 oPosition : POSITION,
    out float4 oColor : TEXCOORD0,
    out float2 oUv : TEXCOORD1)
{
    float a = lerp(1.0, iDirA.w, uP[6].x);
    float tsec = (iPosAge.w - aB.x * uP[1].x) * uP[1].w;
    float pl = lerp(uP[1].y, uP[1].z, aB.y);
    float t = tsec / pl;
    float alive = step(0.0, t) * step(t, 1.0);
    float v0 = lerp(uP[0].x, uP[0].y, aA.w) * a;
    float travel = uP[6].y * a + v0 * tsec * (1.0 - 0.5 * uP[0].w * t);
    float3 r;
    float3 u;
    frame(iDirA.xyz, r, u);
    float3 d = r * aA.x + u * aA.y + iDirA.xyz * aA.z;
    float3 world = iPosAge.xyz + d * travel;
    world.y += (uP[6].z - 0.5 * uP[0].z * tsec) * tsec;
    float size = lerp(uP[2].x, uP[2].y, t) * (1.0 - uP[2].z * aB.z) * alive * a;
    float3 vel = d * (v0 * (1.0 - uP[0].w * t)) + float3(0.0, uP[6].z - uP[0].z * tsec, 0.0);
    float sp = length(vel);
    float3 axis = vel / max(sp, 0.001);
    float3 side = normalize(cross(axis, uCam[2].xyz - world) + float3(0.0, 0.0001, 0.0));
    float3 along = side * (aC.x * size) + axis * (aC.y * size * (1.0 + uP[2].w * sp));
    float3 facing = uCam[0].xyz * (aC.x * size) + uCam[1].xyz * (aC.y * size);
    world += lerp(facing, along, step(0.0005, uP[2].w));
    oPosition = mul(uMvp, float4(world, 1.0));
    float4 c = lerp(uP[3], uP[4], t);
    c.a *= min(t / max(uP[7].x, 0.001), 1.0) * pow(max(1.0 - t, 0.0), uP[6].w) * alive;
    oColor = c;
    oUv = lerp(uP[5].xy, uP[5].zw, aC.xy * 0.5 + 0.5);
}
