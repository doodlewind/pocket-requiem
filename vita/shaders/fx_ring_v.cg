void main(
    float4 aA,
    float4 aB,
    float4 aC,
    float4 iPosAge,
    float4 iDirA,
    uniform float4x4 uMvp,
    uniform float4 uP[8],
    uniform float4 uCam[3],
    out float4 oPosition : POSITION,
    out float4 oColor : TEXCOORD0,
    out float2 oUv : TEXCOORD1)
{
    float a = lerp(1.0, abs(iDirA.w), uP[2].w);
    float sgn = lerp(1.0, sign(iDirA.w), uP[6].z);
    float t = iPosAge.w;
    float te = pow(t, uP[1].w);
    float rad = lerp(lerp(uP[0].x, uP[0].y, te), lerp(uP[0].z, uP[0].w, te), aA.y) * a;
    float th = (aA.x * uP[1].x + uP[1].y + uP[1].z * t) * sgn;
    float3 r;
    float3 u;
    float3 fh;
    float3 rh;
    frame(iDirA.xyz, r, u);
    flatFrame(iDirA.xyz, fh, rh);
    // ground: forward and right on the ground. facing: across the direction. swing: forward and a tilted right.
    float mode = uP[6].x;
    float isFacing = step(0.5, mode) * step(mode, 1.5);
    float isSwing = step(1.5, mode);
    float3 axU = lerp(fh, r, isFacing);
    float3 tilted = rh * cos(uP[6].y) + float3(0.0, sin(uP[6].y) * sgn, 0.0);
    float3 axV = lerp(lerp(rh, u, isFacing), tilted, isSwing);
    float3 world = iPosAge.xyz + float3(0.0, uP[2].z, 0.0) + axU * (cos(th) * rad) + axV * (sin(th) * rad);
    oPosition = mul(uMvp, float4(world, 1.0));
    float4 c = lerp(uP[3], uP[4], t);
    float along = aA.x * 0.5 + 0.5;
    c.a *= pow(max(1.0 - t, 0.0), uP[2].y) * lerp(1.0, sin(along * 3.14159), uP[7].w);
    oColor = c;
    oUv = lerp(uP[5].xy, uP[5].zw, float2(along, aA.y));
}
