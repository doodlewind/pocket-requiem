; Skinned models: the mage and the demon, in draws of at most 19 bones. Two
; bones per vertex; `bones` holds three rows per bone, taking a bind-pose
; position to world space. The light is the look of the animation at night,
; as the Vita's program has it: a lit tone and a shaded tone that meet at a
; narrow edge, and what the spells cast. The tint is sRGB, so the light is
; encoded before it multiplies; the square root stands in for the 1 / 2.2 power.
.fvec projection[4]
.fvec bones[57]
; the moon's direction and how much of it arrives; its colour; sky; bounce.
.fvec light[4]
; per light: its place with 1 / radius^2 in w, then its colour.
.fvec cast[4]
.constf consts(1.0, 3.0, 0.0039215686, 0.5)
.constf more(0.0, 1.15, 0.00001, 0.007874016)
; the edge between the tones: (facing + 0.04) / 0.14, and the sky's share of the shade
.constf tone(0.04, 7.142857, 2.1, 0.0)
; a cast light on a surface: 0.36 + 0.84 * max(n . l, 0)
.constf wrap(0.36, 0.84, 0.0, 0.0)
.in inpos v0
.in innrm v1
.in inclr v2
; first uniform row of bone 0 and of bone 1, weight 0, weight 1
.in inbw v3
.out outpos position
.out outclr color
.entry main
.proc main
    mov r0.xyz, inpos.xyz
    mov r0.w, consts.x
    mul r10.xyz, more.www, innrm.xyz
    ; A source's swizzle is applied before the write mask picks components:
    ; `mul r1.zw, c.zz, inbw.zw` would read inbw.w for both. Scale all four
    ; and use r1.z and r1.w.
    mul r1, consts.zzzz, inbw

    ; The attribute holds each bone's first row, a whole number: a product
    ; computed here could truncate to the row before.
    mova a0.x, inbw.x
    dp4 r2.x, bones[a0.x], r0
    dp4 r2.y, bones[a0.x+1], r0
    dp4 r2.z, bones[a0.x+2], r0
    dp3 r3.x, bones[a0.x], r10
    dp3 r3.y, bones[a0.x+1], r10
    dp3 r3.z, bones[a0.x+2], r10

    mova a0.x, inbw.y
    dp4 r4.x, bones[a0.x], r0
    dp4 r4.y, bones[a0.x+1], r0
    dp4 r4.z, bones[a0.x+2], r0
    dp3 r5.x, bones[a0.x], r10
    dp3 r5.y, bones[a0.x+1], r10
    dp3 r5.z, bones[a0.x+2], r10

    mul r2.xyz, r1.zzz, r2.xyz
    mul r4.xyz, r1.www, r4.xyz
    add r2.xyz, r2.xyz, r4.xyz
    mov r2.w, consts.x
    dp4 outpos.x, projection[0], r2
    dp4 outpos.y, projection[1], r2
    dp4 outpos.z, projection[2], r2
    dp4 outpos.w, projection[3], r2

    mul r3.xyz, r1.zzz, r3.xyz
    mul r5.xyz, r1.www, r5.xyz
    add r3.xyz, r3.xyz, r5.xyz
    dp3 r6.x, r3, r3
    max r6.x, more.z, r6.x
    rsq r6.x, r6.x
    mul r3.xyz, r3.xyz, r6.xxx

    ; lit = clamp((n . moon + 0.04) / 0.14, 0, 1) * how much of the moon arrives
    dp3 r6.x, light[0], r3
    add r6.x, tone.x, r6.x
    mul r6.x, tone.y, r6.x
    max r6.x, more.x, r6.x
    min r6.x, consts.x, r6.x
    mul r6.x, light[0].w, r6.x
    ; light = sky * 2.1 + bounce + moon * 1.15 * lit
    mov r7.xyz, light[2].xyz
    mul r7.xyz, tone.zzz, r7.xyz
    add r7.xyz, light[3].xyz, r7.xyz
    mul r6.x, more.y, r6.x
    mov r8.xyz, light[1].xyz
    mul r8.xyz, r6.xxx, r8.xyz
    add r7.xyz, r7.xyz, r8.xyz

    ; what the spells cast: (1 - d^2 / r^2)^2 * (0.36 + 0.84 * max(n . l, 0)) of each light's colour
    mov r9, cast[0]
    add r8.xyz, r9.xyz, -r2.xyz
    dp3 r8.w, r8, r8
    max r6.z, more.z, r8.w
    rsq r6.z, r6.z
    dp3 r6.y, r3, r8
    mul r6.y, r6.z, r6.y
    max r6.y, more.x, r6.y
    mul r6.y, wrap.y, r6.y
    add r6.y, wrap.x, r6.y
    mul r8.w, r9.w, r8.w
    add r8.w, consts.x, -r8.w
    max r8.w, more.x, r8.w
    mul r8.w, r8.w, r8.w
    mul r8.w, r6.y, r8.w
    mov r9.xyz, cast[1].xyz
    mul r9.xyz, r8.www, r9.xyz
    add r7.xyz, r7.xyz, r9.xyz
    mov r9, cast[2]
    add r8.xyz, r9.xyz, -r2.xyz
    dp3 r8.w, r8, r8
    max r6.z, more.z, r8.w
    rsq r6.z, r6.z
    dp3 r6.y, r3, r8
    mul r6.y, r6.z, r6.y
    max r6.y, more.x, r6.y
    mul r6.y, wrap.y, r6.y
    add r6.y, wrap.x, r6.y
    mul r8.w, r9.w, r8.w
    add r8.w, consts.x, -r8.w
    max r8.w, more.x, r8.w
    mul r8.w, r8.w, r8.w
    mul r8.w, r6.y, r8.w
    mov r9.xyz, cast[3].xyz
    mul r9.xyz, r8.www, r9.xyz
    add r7.xyz, r7.xyz, r9.xyz

    ; sqrt(x) = x * rsq(x)
    max r7.xyz, more.zzz, r7.xyz
    rsq r8.x, r7.x
    rsq r8.y, r7.y
    rsq r8.z, r7.z
    mul r7.xyz, r7.xyz, r8.xyz

    mul r9.xyz, consts.zzz, inclr.xyz
    mul r9.xyz, r9.xyz, r7.xyz
    mov r9.w, consts.x
    mov outclr, r9
    end
.end
